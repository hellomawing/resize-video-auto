#!/bin/bash
# cmd/install_init —— 安装前检查
#
# 这个应用本体跑在容器里，所以先确认目标机器上 Docker 是可用的。
# 提前拦下来，比装到最后一步才失败、用户一脸问号要好得多。

if ! command -v docker >/dev/null 2>&1; then
    echo "未检测到 Docker 环境。请先在「应用中心 → Docker」里启用容器功能，再安装本应用。" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

if ! docker info >/dev/null 2>&1; then
    echo "Docker 服务未启动或当前用户没有访问权限。请确认 Docker 已正常运行后重试。" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

exit 0
