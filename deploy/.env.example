# 复制成 .env 后按自己的情况改，然后 docker compose up -d

# 你的 Docker Hub 镜像地址（改成自己的用户名）
VS_IMAGE=yourname/video-splitter:latest

# 网页端口
VS_PORT=8099

# 时区，影响定时任务按几点触发
TZ=Asia/Shanghai

# 容器内进程的属主。SSH 到 NAS 执行 `id 你的用户名` 查，取 uid 和 gid 两项。
# 注意 gid 往往不是 uid：实测飞牛 fnOS 的 admin 是 1000:1001（Users 组是 1001），
# 群晖则常见 1026:100。填错不会报错，但切片在文件管理里会改不动也删不掉。
# 设成 0 就是以 root 运行。
PUID=1000
PGID=1001

# 配置与数据库的存放位置（容器内即 /data）。
# 里面是 settings.json / watchpoints.json / video-splitter.db / archive-dirs.json，
# 也就是全部状态：备份拷这一个目录就够。
#
# 建议写成**绝对路径**，例如 /vol1/1000/video-splitter/data：
#   - 相对路径（./data）是相对 compose 文件所在目录解析的，跟着 deploy/ 走，
#     哪天挪了目录、或者用别的路径执行 compose，就会指向另一个空目录，
#     看起来就像「数据全丢了」；
#   - 绝对路径在备份脚本、迁移到新机器时都更省事。
#
# ⚠️ 改这一项**不会自动搬数据**：先 `docker compose down`，把旧目录整个拷到
#    新位置（保留属主），再改这里、`docker compose up -d`。
VS_DATA=./data
