# 复制成 .env 后按自己的情况改，然后 docker compose up -d

# Docker Hub 镜像地址（发布者已公开；fork 改你自己的账号）
VS_IMAGE=mawing/video-splitter:latest

# 网页端口
VS_PORT=8099

# 时区，影响定时任务按几点触发
TZ=Asia/Shanghai

# 容器内进程的属主。SSH 到 NAS 执行 `id 你的用户名` 查，取 uid 和 gid 两项。
# 注意 gid 往往不是 uid：实测飞牛 fnOS 的 admin 是 1000:1001（Users 组是 1001），
# 群晖则常见 1026:100。填错不会报错，但切片在文件管理里会改不动也删不掉。
# 设成 0 就是以 root 运行。
PUID=1000
PGID=1001

# 配置与数据库（容器内 /data）由 Docker 自己管理，存在名为
# video-splitter-data 的卷里，**这一项不用填、也没得填**：
#   docker volume inspect video-splitter-data    # 看它在宿主机的真实位置
#   docker run --rm -v video-splitter-data:/data -v "$PWD":/backup \
#     alpine tar czf /backup/vs-data.tgz -C /data .   # 整卷打包备份
# 日常备份更省事的做法是网页「设置 → 导出配置」（设置、监控目录、归档记录），
# 换机器时再导入回来。
