# 复制成 .env 后按自己的情况改，然后 docker compose up -d

# Docker Hub 镜像地址（发布者已公开；fork 改你自己的账号）
VS_IMAGE=mawing/video-splitter:latest

# 网页端口
VS_PORT=8099

# 时区，影响定时任务按几点触发
TZ=Asia/Shanghai

# 要处理的视频目录（宿主机路径），挂载成容器内的 /test-video。
# 改法：把宿主机目录替换成你自己的，例如 VS_MEDIA_MOUNT=/vol1/1000/my-inbox
# 注意：这一项在部署机侧 deploy/.env 里改即可，部署脚本不会覆盖 .env。
VS_MEDIA_MOUNT=/vol1/1000/video-split-in

# 容器内进程的属主。SSH 到主机执行 `id 你的用户名` 查，取 uid 和 gid 两项。
# 注意 gid 往往不是 uid。填错不会报错，但切片在文件管理里会改不动也删不掉。
# 设成 0 就是以 root 运行。
PUID=1000
PGID=1001

# 访问密码（可选）。这一段默认注释掉，注释掉 = 无需密码即可访问网页。
# 如果这台 NAS 会暴露在公网上（端口映射 / frp / 隧道），强烈建议取消注释填一个：
# 打开网页需要先输入它才能操作。单个密码、不需要用户名。
# 优先级：这个环境变量 > 网页「设置 → 访问密码」里填的。
# 配了它之后，网页上改不了也关闭不了，只能改这里重建容器。
# 它同时也是一次性的复位手段：每次重启会把网页密码更新成这个值，
# 忘了网页密码时配它重启即可重置。
# VS_ACCESS_PASSWORD=改成你自己的强密码

# 配置与数据库（容器内 /data）由 Docker 自己管理，存在名为
# video-splitter-data 的卷里，**这一项不用填、也没得填**：
#   docker volume inspect video-splitter-data    # 看它在宿主机的真实位置
#   docker run --rm -v video-splitter-data:/data -v "$PWD":/backup \
#     alpine tar czf /backup/vs-data.tgz -C /data .   # 整卷打包备份
# 日常备份更省事的做法是网页「设置 → 导出配置」（设置、监控目录、归档记录），
# 换机器时再导入回来。
