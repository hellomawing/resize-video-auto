# 复制成 .env 后按自己的情况改，然后 docker compose up -d

# 你的 Docker Hub 镜像地址（改成自己的用户名）
VS_IMAGE=yourname/video-splitter:latest

# 网页端口
VS_PORT=8099

# 时区，影响定时任务按几点触发
TZ=Asia/Shanghai

# 容器内进程的属主。SSH 到 NAS 执行 `id 你的用户名` 查，fnOS 默认管理员是 1000:1000。
# 设成 0 就是以 root 运行。
PUID=1000
PGID=1000

# 配置与数据库的存放位置
VS_DATA=./data
