# ---------------------------------------------------------------- 运行时数据
# 配置、数据库、任务历史；服务启动时会自动创建
data/
.tmp-test/
# 打包上传到 NAS 时用的临时目录（源码包、测试视频）
.tmp-deploy/
# 验收测试用的临时素材
.tmp-verify/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------- 前端
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo

# ---------------------------------------------------------------- 部署
# 这里有真实 PUID/PGID 与镜像地址，属于本机配置，不要提交
deploy/.env
# 这台 NAS 的真实账号密码。只在本机存在，任何情况下都不要提交。
deploy/.nas-credentials
.nas-credentials

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ---------------------------------------------------------------- 本地会话数据
# 保留在本机即可，不要提交
.workbuddy/
# AI 助手的工作区数据（含本地记忆、临时状态），同样只留在本机
.workbuddy-ai/
