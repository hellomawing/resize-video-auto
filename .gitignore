# ---------------------------------------------------------------- 运行时数据
# 配置、数据库、任务历史；服务启动时会自动创建
data/
.tmp-test/
# 打包上传到 NAS 时用的临时目录（源码包、测试视频）
.tmp-deploy/
# 验收测试用的临时素材
.tmp-verify/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------- CLI 打包产物
# cli/build_exe.py 的输出：dist/ 是可执行文件，build/ 是中间文件。
# 两边都体积不小、且能在任意平台重新生成，所以不进仓库。
# 想发布就去 GitHub Release 挂附件，别直接提交二进制。
cli/dist/
cli/build/
*.spec

# PyInstaller 的临时分析缓存（--clean 时删的就是它）
cli/__pyinstaller/
build/pyinstaller/
pyinstaller-cache/

# 脚本运行时自己产生的文件，属于本机状态，不进仓库：
#   运行日志、自动下载的 ffmpeg、向导保存的预设
cli/video_splitter_log.txt
cli/ffmpeg/
cli/presets.json

# ---------------------------------------------------------------- 前端
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo

# ---------------------------------------------------------------- 部署
# 这里有真实 PUID/PGID 与镜像地址，属于本机配置，不要提交
deploy/.env
# 这台 NAS 的真实账号密码。只在本机存在，任何情况下都不要提交。
deploy/.nas-credentials
.nas-credentials

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ---------------------------------------------------------------- 本地会话数据
# 保留在本机即可，不要提交
.workbuddy/
# AI 助手的工作区数据（含本地记忆、临时状态），同样只留在本机
.workbuddy-ai/
